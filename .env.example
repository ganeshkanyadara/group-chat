# 32-byte (64 hex characters) AES encryption key for message storage
CHAT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Backend Instance Identifier (unique per system: backend-1, backend-2, backend-3)
BACKEND_ID=backend-1

# Network Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000

# Shared Database Location (file path or sqlite:/// URL)
# All backend instances must point to the same database file (e.g. NFS / shared disk)
DATABASE_URL=/path/to/shared/chat.db
# Alternatively:
# CHAT_DB_PATH=chat.db

# Keys directory for Ed25519 sender private keys
KEYS_DIR=keys
